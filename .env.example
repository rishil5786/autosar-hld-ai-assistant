# ==============================================
# AUTOSAR HLD AI - Environment Configuration
# ==============================================
# Copy this file to .env and configure values

# --- LLM Configuration ---
# Options: "openai", "huggingface", "ollama", "none"
LLM_PROVIDER=none
LLM_MODEL_NAME=mistral

# OpenAI (if using)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Ollama (if using local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# HuggingFace (if using)
HF_API_TOKEN=
HF_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.1

# --- Embedding Configuration ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# --- Vector Store ---
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=data/vector_store

# --- Database ---
DATABASE_URL=sqlite:///data/autosar_hld.db

# --- Application ---
APP_NAME=AUTOSAR HLD AI Assistant
APP_HOST=0.0.0.0
APP_PORT=8000
STREAMLIT_PORT=8501
SECRET_KEY=change-this-to-a-random-secret-key-in-production
MAX_UPLOAD_SIZE_MB=50
LOG_LEVEL=INFO

# --- OCR ---
TESSERACT_PATH=
OCR_ENABLED=true

# --- Security ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
